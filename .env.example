# Frontend listener (the server defaults to 3000)
PORT=3000

# Optional external FastAPI origin. Leave unset to use the bundled backend in production.
# Do not append /api; the proxy adds the upstream /api/* path.
# FLOWTRACE_API_URL=http://127.0.0.1:8000

# Optional proxy request timeout in milliseconds.
# FLOWTRACE_PROXY_TIMEOUT_MS=10000

# Optional n8n chatbot webhook. It must be an HTTPS URL; no default endpoint is provided.
# FLOWTRACE_CHAT_WEBHOOK_URL=

# Optional chatbot timeout in milliseconds (capped at 90000; default 90000).
# FLOWTRACE_CHAT_TIMEOUT_MS=90000
