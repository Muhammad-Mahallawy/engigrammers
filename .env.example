# Frontend listener (the server defaults to 3000)
PORT=3000

# Optional external FastAPI origin. The default is http://127.0.0.1:8000.
# The production container starts the included backend automatically when unset.
# Do not append /api or /docs; the proxy adds the upstream /api/* path.
# FLOWTRACE_API_URL=http://127.0.0.1:8000

# Optional proxy request timeout in milliseconds.
# FLOWTRACE_PROXY_TIMEOUT_MS=10000
